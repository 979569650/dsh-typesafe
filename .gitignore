# The junction `scripts/install.mjs` creates so this package can resolve the
# harness's own modules from the profile. Machine-specific; never committed.
node_modules/

# Local runs of the audit scripts and live tests.
*.log
.env
.env.*
_*.mjs

# Never commit a registry credential. A publish token lives here only for the
# duration of one `npm publish` and is deleted immediately afterwards.
.npmrc

# Editor and OS noise.
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
